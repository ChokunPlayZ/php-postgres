# Ignore OS-specific files
.DS_Store
Thumbs.db

# Ignore IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Ignore temporary files
*.tmp
*.log
*.cache

# Ignore Docker volumes
postgres_data/

# Ignore environment files with sensitive data
.env
.env.local
.env.production

# Ignore build archives; keep individual source patches tracked
*.tar
*.tar.gz
